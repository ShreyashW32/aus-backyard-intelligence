# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# scripts/run_demo.ps1 loads .env automatically.

# Optional: Google Geocoding API key for exact lead addresses.
# Use a server-side key restricted to the Geocoding API and your server's IP.
ABI_GOOGLE_MAPS_API_KEY=

# Set to 0 to disable dev/eval endpoints in a public deployment.
ABI_DEV_API=1

# Optional: path to pool-trained YOLO weights (.pt or .onnx).
# QLDR_POOL_YOLO_WEIGHTS=models/pool_yolo.pt
